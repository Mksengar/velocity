# ============================================================
# Velocity BI - Environment Configuration
# File: backend/.env.example
# ============================================================


# ============================================================
# Application
# ============================================================

FLASK_ENV=development

APP_NAME=Velocity BI

SECRET_KEY=change-this-to-a-random-secret-key

JWT_SECRET_KEY=change-this-to-a-random-jwt-secret-key

JWT_EXPIRE_HOURS=24


# ============================================================
# Server
# ============================================================

HOST=0.0.0.0

PORT=5000


# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500


# ============================================================
# MySQL Database
# ============================================================

DATABASE_TYPE=mysql

DB_HOST=localhost

DB_PORT=3306

DB_NAME=velocity_bi

DB_USER=root

DB_PASSWORD=your_mysql_password


# ============================================================
# Optional Full Database URL
# ============================================================
# If DATABASE_URL is provided, your application can use it
# instead of constructing the URL from the variables above.

# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/velocity_bi


# ============================================================
# Dataset Settings
# ============================================================

MAX_DATASET_ROWS=100000

MAX_DATASET_COLUMNS=200


# ============================================================
# File Upload
# ============================================================

MAX_UPLOAD_SIZE_MB=50

ALLOWED_EXTENSIONS=csv,xlsx,xls,json,txt


# ============================================================
# Reports
# ============================================================

REPORT_FORMATS=pdf,xlsx,csv


# ============================================================
# Security
# ============================================================

BCRYPT_LOG_ROUNDS=12


# ============================================================
# Optional External API
# ============================================================

API_BASE_URL=http://127.0.0.1:5000/api


# ============================================================
# Production Settings
# ============================================================

# Set these only when deploying the application.

# FLASK_ENV=production

# SECRET_KEY=your-production-secret-key

# JWT_SECRET_KEY=your-production-jwt-secret-key

# DB_HOST=your-production-database-host

# DB_PORT=3306

# DB_NAME=velocity_bi

# DB_USER=your-production-db-user

# DB_PASSWORD=your-production-db-password